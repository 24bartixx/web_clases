# Alpha Vantage API Configuration
# Skopiuj ten plik na .env i uzupełnij wartościami
# cp .env.example .env

# API Key - pobierz ze strony: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# API Settings
API_BASE_URL=https://www.alphavantage.co/query
RATE_LIMIT_DELAY=0.2

# Rate Limits (Free Plan)
MAX_REQUESTS_PER_MINUTE=5
MAX_REQUESTS_PER_DAY=500

# Monitored Symbols (oddzielone przecinkami)
SYMBOLS_TO_WATCH=IBM,MSFT,AAPL,GOOGL,AMZN

# Debug Mode (True/False)
DEBUG=False
