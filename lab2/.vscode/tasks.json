{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Download scss",
        "type": "shell",
        "command": "npm install -g sass",
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    {
        "label": "Open HTML",
        "type": "shell",
        "command": "start index.html",
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    {
        "label": "Enable live scss",
        "type": "shell",
        "command": "sass --watch scss/styles.scss:css/styles.css",
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    }
]
}